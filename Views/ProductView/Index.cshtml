@model IEnumerable<ProductApi.Models.Product>

<h2>Product List</h2>

<div class="mb-3">
    <a href="/ProductView/Create" class="btn btn-primary">
        Add Product
    </a>

    <a href="/AuthView/Logout" class="btn btn-danger">
        Logout
    </a>
</div>

<form method="get" action="/ProductView/Index" class="mb-3">
    <input type="text"
           name="search"
           value="@Context.Request.Query["search"]"
           placeholder="Search name"
           class="form-control mb-2" />

    <input type="number"
           name="minPrice"
           value="@Context.Request.Query["minPrice"]"
           placeholder="Min Price"
           class="form-control mb-2" />

    <input type="number"
           name="maxPrice"
           value="@Context.Request.Query["maxPrice"]"
           placeholder="Max Price"
           class="form-control mb-2" />

    <button type="submit" class="btn btn-primary">
        Search
    </button>
</form>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@item.Price</td>
                <td>
                    <a href="/ProductView/Edit/@item.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a href="/ProductView/Delete/@item.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>