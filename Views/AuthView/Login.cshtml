@{
    ViewData["Title"] = "Login";
}

<h2>Login</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form method="post" action="/AuthView/Login">

<div class="mb-3">
<label>Username</label>
<input name="username" class="form-control"/>
</div>

<div class="mb-3">
<label>Password</label>
<input name="password"
type="password"
class="form-control"/>
</div>

<button class="btn btn-primary">
Login
</button>
<p class="mt-3">
Belum punya akun?
<a href="/AuthView/Register">
Register
</a>
</p>

</form>